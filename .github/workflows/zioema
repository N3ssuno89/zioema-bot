name: ZioEMA bot

on:
  # SCHEDULE DISATTIVATO DI PROPOSITO.
  # I pattern URL di 20 siti su 23 non sono ancora verificati: se parte da solo
  # ogni 15 minuti prima del primo --dry-run, brucia chiamate API e ti riempie
  # Telegram di bozze sbagliate. Togli il commento SOLO dopo il dry-run.
  # schedule:
  #   - cron: "*/15 * * * *"
  workflow_dispatch:          # per ora parte solo col bottone "Run workflow"

permissions:
  contents: write

concurrency:
  group: zioema-bot
  cancel-in-progress: false

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - run: pip install -r requirements.txt

      - name: Genera e manda le bozze
        env:
          ANTHROPIC_API_KEY:  ${{ secrets.ANTHROPIC_API_KEY }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID:   ${{ secrets.TELEGRAM_CHAT_ID }}
        run: python3 harvest.py

      - name: Salva lo stato
        run: |
          git config user.name  "zioema-bot"
          git config user.email "bot@users.noreply.github.com"
          git add seen.json
          git diff --staged --quiet || git commit -m "seen: $(date -u +%FT%TZ)"
          git push
